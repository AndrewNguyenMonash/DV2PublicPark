{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "C9 Every day of booked park activity. Idiom: calendar heatmap (2024 and 2025; x = week, y = weekday, shading = bookings that day). Filter out 2023 (booking system roll-out).",
  "width": "container",
  "height": 200,
  "data": {
    "url": "data/derived/bne_bookings_calendar.csv"
  },
  "transform": [
    {
      "aggregate": [
        {
          "op": "count",
          "as": "rows"
        }
      ]
    },
    {
      "calculate": "'C09 placeholder: ' + datum.rows + ' rows loaded'",
      "as": "label"
    }
  ],
  "mark": {
    "type": "text",
    "fontSize": 14,
    "fontStyle": "italic",
    "color": "#992e79"
  },
  "encoding": {
    "text": {
      "field": "label",
      "type": "nominal"
    }
  },
  "config": {
    "background": "#fbfaf5",
    "font": "Source Sans 3",
    "view": {
      "stroke": null
    },
    "title": {
      "fontSize": 15,
      "color": "#1f2a24",
      "anchor": "start"
    },
    "axis": {
      "labelColor": "#5b6660",
      "labelFontSize": 12,
      "titleColor": "#1f2a24",
      "titleFontSize": 12,
      "gridColor": "#e6e3da"
    },
    "legend": {
      "labelColor": "#5b6660",
      "labelFontSize": 12,
      "titleColor": "#1f2a24",
      "titleFontSize": 12
    },
    "mark": {
      "color": "#006837"
    },
    "text": {
      "color": "#1f2a24"
    }
  }
}
