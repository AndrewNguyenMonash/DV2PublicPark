{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "C6 Every mapped park facility. Idiom: dot map, as small multiples (one panel per council). One symbol = one facility, using the same symbols as the page key. Each panel has its own equal-area conic projection, with its standard parallels on the council's northern and southern edges so shapes are true, and its own scale (see the bar under each map). The Show menu filters every panel to one facility type. Fountains are drawn first because they are the most common, so the rarer symbols sit on top.",
  "params": [
    {
      "name": "show",
      "value": "All",
      "bind": {
        "input": "select",
        "options": ["All", "P", "B", "F", "T", "D"],
        "labels": [
          "All facilities",
          "Playgrounds",
          "BBQs",
          "Drinking fountains",
          "Toilets",
          "Dog off-leash areas"
        ],
        "name": "Show: "
      }
    }
  ],
  "data": { "url": "data/derived/facilities_all_councils.csv" },
  "transform": [
    { "filter": "show == 'All' || datum.type == show" },
    {
      "calculate": "datum.type == 'F' ? 1 : datum.type == 'T' ? 2 : datum.type == 'P' ? 3 : datum.type == 'B' ? 4 : 5",
      "as": "draw_order"
    }
  ],
  "vconcat": [
    {
      "width": 324,
      "height": 42,
      "data": {
        "values": [
          {
            "note": "Brisbane has 3,313 mapped facilities, more than the other\nseven councils combined. Canberra's all sit in the north of\nthe ACT (the city); its south is mostly national park."
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "lineBreak": "\n",
        "lineHeight": 14,
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#992e79"
      },
      "encoding": {
        "x": { "value": 0 },
        "y": { "value": 0 },
        "text": { "field": "note", "type": "nominal" }
      }
    },
    {
      "columns": 3,
      "spacing": { "row": 6, "column": 10 },
      "concat": [
